# Server
NODE_ENV=development
PORT=3001

# MongoDB - REQUIRED for dev/start. Set a real connection string, e.g.:
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/mcq-exam?retryWrites=true&w=majority
MONGODB_URI=

# Auth secrets - required in non-test mode, minimum 32 characters. Generate long random values.
JWT_ACCESS_SECRET=replace-with-a-random-32+-character-secret

# CORS - comma-separated list of allowed client origins.
# The FIRST entry is the app users land on after a successful Google sign-in,
# so production must list the real app first (the server refuses to boot
# otherwise). Production value:
#   CLIENT_ORIGIN=https://quizora-rho.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Cookies (false for local development over http)
COOKIE_SECURE=false

# Uploads
# Directory for admin-uploaded test images (PNG/JPEG/GIF/WebP, max 2MB),
# resolved relative to the server process cwd. Left empty it defaults to
# server/uploads (gitignored).
UPLOAD_DIR=uploads

# Google OAuth (required in production; the server fails fast without them)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must be the exact URL registered in Google Cloud, and must be reachable by the
# browser: the production one rides the Vercel /api rewrite.
OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/oauth/google/callback
# Comma-separated Google accounts that resolve to role ADMIN on every sign-in.
ADMIN_EMAILS=

# Server
NODE_ENV=development
PORT=3001

# MongoDB - REQUIRED for dev/start. Set a real connection string, e.g.:
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/mcq-exam?retryWrites=true&w=majority
MONGODB_URI=

# Auth secrets - required in non-test mode, minimum 32 characters. Generate long random values.
JWT_ACCESS_SECRET=replace-with-a-random-32+-character-secret

# Both profiles live in this file. NODE_ENV=production selects *_PROD;
# development/test selects *_DEV. Profile values override legacy unsuffixed keys.
CLIENT_ORIGIN_DEV=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173,http://localhost:4173,http://127.0.0.1:4173,http://[::1]:4173
PUBLIC_BACKEND_ORIGIN_DEV=http://localhost:3001
OAUTH_CALLBACK_URL_DEV=http://localhost:3001/api/auth/oauth/google/callback
COOKIE_SECURE_DEV=false

CLIENT_ORIGIN_PROD=https://quizora-techteam.vercel.app
PUBLIC_BACKEND_ORIGIN_PROD=https://quizora-ppfp.onrender.com
OAUTH_CALLBACK_URL_PROD=https://quizora-techteam.vercel.app/api/auth/oauth/google/callback
COOKIE_SECURE_PROD=true

# Uploads
# Directory for admin-uploaded test images (PNG/JPEG/GIF/WebP, max 2MB),
# resolved relative to the server process cwd. Left empty it defaults to
# server/uploads (gitignored).
UPLOAD_DIR=uploads

# Google OAuth (required in production; the server fails fast without them)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Register the exact callback URLs above in Google Cloud's authorized redirect URIs.
# If using 127.0.0.1 locally, also register:
# http://127.0.0.1:3001/api/auth/oauth/google/callback
# Comma-separated Google accounts that resolve to role ADMIN on every sign-in.
ADMIN_EMAILS=

# Server
NODE_ENV=development
PORT=3001

# MongoDB - REQUIRED for dev/start. Set a real connection string, e.g.:
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/mcq-exam?retryWrites=true&w=majority
MONGODB_URI=

# Auth secrets - required in non-test mode, minimum 32 characters. Generate long random values.
JWT_ACCESS_SECRET=replace-with-a-random-32+-character-secret
JWT_REFRESH_SECRET=replace-with-a-random-32+-character-secret

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Cookies (false for local development over http)
COOKIE_SECURE=false
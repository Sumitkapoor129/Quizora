# Server
NODE_ENV=development
PORT=3001

# MongoDB - REQUIRED for dev/start. Set a real connection string, e.g.:
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/mcq-exam?retryWrites=true&w=majority
MONGODB_URI=

# Auth secrets - required in non-test mode, minimum 32 characters. Generate long random values.
JWT_ACCESS_SECRET=replace-with-a-random-32+-character-secret
JWT_REFRESH_SECRET=replace-with-a-random-32+-character-secret

# CORS - comma-separated list of allowed client origins
CLIENT_ORIGIN=http://localhost:5173,https://quizora-ashen.vercel.app

# Cookies (false for local development over http)
COOKIE_SECURE=false

# Uploads
# Directory for admin-uploaded test images (PNG/JPEG/GIF/WebP, max 2MB),
# resolved relative to the server process cwd. Left empty it defaults to
# server/uploads (gitignored).
UPLOAD_DIR=uploads

# SMTP (email OTP delivery) - OPTIONAL. Without these the server still boots
# and OTP flows print the code to the server console in development.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=your-gmail-address@gmail.com
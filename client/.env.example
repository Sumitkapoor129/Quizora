# Public frontend configuration only. Vite embeds these values at build time.
# Browser hostname selects dev for localhost / 127.0.0.1 / ::1, prod otherwise.
# Leave dev blank to use the page's loopback hostname on port 3001.
VITE_API_URL_DEV=
# Production uses the same-origin Vercel proxy so browsers that block third-party cookies work.
VITE_API_URL_PROD=
# Optional legacy fallback when the selected URL above is blank:
# VITE_API_URL=

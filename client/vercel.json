{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "${BACKEND_URL}/api/$1",
      "env": ["BACKEND_URL"]
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://quizora-95vx.onrender.com/uploads/$1"
    },
    { "source": "/((?!api|uploads|.*\\..*).*)", "destination": "/index.html" }
  ]
}